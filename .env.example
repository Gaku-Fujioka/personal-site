# No credentials are needed for the default empty Journal.
JOURNAL_SOURCE=empty

# For local display review only (the CMS writes to a different directory):
# JOURNAL_SOURCE=local
# JOURNAL_LOCAL_DIR=.journal/source

# After the private content repository and OAuth host have been configured:
# JOURNAL_SOURCE=github
# JOURNAL_REPO=
# JOURNAL_BRANCH=main
# JOURNAL_TOKEN=
# CMS_REPO=
# CMS_AUTH_URL=

# Set the real domain immediately before publication. No placeholder domain.
# SITE_URL=
