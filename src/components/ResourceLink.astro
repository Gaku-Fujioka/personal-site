---
import assets from '../data/brand-assets.json';
interface Props { label: string; url: string | null; variant?: 'pill' | 'social'; }
const { label, url, variant = 'pill' } = Astro.props;
const icons: Record<string, string> = assets.socials;
const icon = icons[label];
---
{url ? (
  <a class={variant === 'social' ? 'social-link' : 'resource-pill'} href={url}>
    {icon && <img class="resource-icon" src={icon} alt="" aria-hidden="true" width="20" height="20" />}
    <span>{label}</span>
    {variant !== 'social' && <span class="external-arrow" aria-hidden="true">↗</span>}
  </a>
) : (
  <span class="resource-pill is-pending">
    <span>{label}</span>
    <span class="pending-label">準備中</span>
  </span>
)}
