---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJournalPosts, journalDate, tagLabel } from '../../lib/journal';
export async function getStaticPaths() {
  return (await getJournalPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishedAt, updatedAt, tags, cover } = post.data;
---
<BaseLayout title={`${title} | Journal | Gaku Fujioka`} description={description} type="article">
  <div class="container inner-page journal-article">
    <a class="text-link back-link" href="/journal/"><span aria-hidden="true">←</span>Journalへ戻る</a>
    <article>
      <header class="article-header">
        <h1>{title}</h1>
        <div class="article-dates"><p>投稿日 <time datetime={publishedAt}>{journalDate(publishedAt)}</time></p>{updatedAt && updatedAt !== publishedAt && <p>更新日 <time datetime={updatedAt}>{journalDate(updatedAt)}</time></p>}</div>
        {tags.length > 0 && <ul class="journal-tag-list" aria-label="記事のタグ">{tags.map(tag => <li><a href={`/journal/tags/${tag}/`}>{tagLabel(tag)}</a></li>)}</ul>}
        <p class="article-summary">{description}</p>
      </header>
      {cover && <figure class="article-cover"><img src={cover.src} srcset={cover.srcset} sizes="(max-width: 767px) calc(100vw - 40px), 680px" width={cover.width} height={cover.height} alt={cover.alt} /><figcaption>{cover.caption}</figcaption></figure>}
      <div class="article-body"><Content /></div>
    </article>
    <div class="page-end"><a class="text-link" href="/journal/"><span aria-hidden="true">←</span>Journalへ戻る</a></div>
  </div>
</BaseLayout>
